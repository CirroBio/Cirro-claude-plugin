    {
      "type": "chart",
      "label": "View",
      "description": "Displays the wired data as a table (default) or a fitting chart.",
      "renderable": true,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "data",
          "type": "Relation",
          "role": "input",
          "cardinality": "one",
          "required": true
        },
        {
          "id": "filter",
          "type": "ScalarParam",
          "role": "filter",
          "cardinality": "many",
          "required": false
        },
        {
          "id": "scale",
          "type": "Scale",
          "role": "scale",
          "cardinality": "one",
          "required": false
        }
      ],
      "outputs": [
        {
          "id": "selection",
          "type": "ScalarParam",
          "role": "selection",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Tile title shown on the dashboard"
          },
          "viewType": {
            "type": "string",
            "enum": [
              "table",
              "histogram",
              "bar",
              "countbar",
              "scatter",
              "boxplot",
              "heatmap",
              "dotplot",
              "hexbin",
              "volcano",
              "line",
              "violin",
              "stacked-area"
            ],
            "default": "table",
            "description": "Data table (default) or a chart type that fits the input columns"
          },
          "spec": {
            "type": "string",
            "description": "Mosaic spec for chart views; generated from viewType, editable per channel"
          },
          "showPoints": {
            "type": "boolean",
            "default": false,
            "description": "Box plot / violin: overlay individual observations (off by default)"
          },
          "maxPoints": {
            "type": "number",
            "description": "Box plot / violin: cap on overlaid points (reservoir-sampled); defaults to 500 when unset"
          },
          "widthScale": {
            "type": "string",
            "enum": [
              "area",
              "count",
              "width"
            ],
            "default": "area",
            "description": "Violin: width scaling (area = equal area, count = scale by n, width = equal max width)"
          },
          "showBox": {
            "type": "boolean",
            "default": true,
            "description": "Violin: draw the inner quartile box + median + whiskers (on by default)"
          },
          "maxKdeSample": {
            "type": "number",
            "description": "Violin: per-category cap on rows feeding the KDE (reservoir-sampled); defaults to 5000 when unset"
          },
          "colorDomain": {
            "type": "array",
            "items": {},
            "description": "Isolated color window [min,max] for a quantitative color channel (recolor; persists per chart)"
          },
          "colorTreatCategorical": {
            "type": "boolean",
            "default": false,
            "description": "Treat a numeric color column as categorical (e.g. a cluster id) instead of a continuous scale"
          },
          "selectionValue": {
            "description": "The current row selection, exposed to wired params"
          },
          "selectionColumn": {
            "type": "string",
            "description": "Column the selection is emitted on (wired X channel, or the table dimension column)"
          },
          "useHexbin": {
            "type": "boolean",
            "default": false,
            "description": "Scatter: render as a hexbin density instead of one SVG node per row"
          },
          "significanceP": {
            "type": "number",
            "description": "Volcano: significance cutoff (p-value); the horizontal guide is placed to match pValueScale. Defaults to 0.05 when unset"
          },
          "foldChange": {
            "type": "number",
            "description": "Volcano: |log2 fold-change| cutoff; vertical guides at ±value. Defaults to 1 when unset"
          },
          "showThresholds": {
            "type": "boolean",
            "default": true,
            "description": "Volcano: master switch for the threshold guide lines"
          },
          "pValueScale": {
            "type": "string",
            "enum": [
              "prescaled",
              "apply",
              "raw"
            ],
            "default": "prescaled",
            "description": "Volcano: what the y column holds — prescaled (already -log10, plot as-is), apply (raw p, -log10 it for display, zeros clamped), or raw (raw p, plot untransformed). Also decides where the significance guide sits"
          },
          "showSignificanceLine": {
            "type": "boolean",
            "default": true,
            "description": "Volcano: draw the horizontal significance guide"
          },
          "showFoldChangeLines": {
            "type": "boolean",
            "default": true,
            "description": "Volcano: draw the ±fold-change vertical guides"
          },
          "xScale": {
            "type": "string",
            "enum": [
              "linear",
              "log",
              "sqrt",
              "symlog"
            ],
            "description": "X-axis scale override (View inspector advanced section)"
          },
          "yScale": {
            "type": "string",
            "enum": [
              "linear",
              "log",
              "sqrt",
              "symlog"
            ],
            "description": "Y-axis scale override (View inspector advanced section)"
          },
          "xPadding": {
            "type": "number",
            "description": "X-axis padding override (0-1)"
          },
          "yPadding": {
            "type": "number",
            "description": "Y-axis padding override (0-1)"
          },
          "xTickRotate": {
            "type": "number",
            "description": "X-axis tick label rotation, in degrees"
          },
          "yTickRotate": {
            "type": "number",
            "description": "Y-axis tick label rotation, in degrees"
          },
          "specRawEdited": {
            "type": "boolean",
            "description": "Set when the spec was hand-edited; a chart-type change asks before regenerating it"
          },
          "showLegend": {
            "type": "boolean",
            "description": "Color legend on/off; unset shows it when color is encoded"
          },
          "showLegendTitle": {
            "type": "boolean",
            "description": "Color legend title line on/off; unset shows it"
          },
          "legendTitle": {
            "type": "string",
            "description": "Color legend title text; unset uses the color column label"
          },
          "showSizeLegend": {
            "type": "boolean",
            "description": "Size legend on/off; unset shows it when a size column is bound"
          },
          "showSizeLegendTitle": {
            "type": "boolean",
            "description": "Size legend title line on/off; unset shows it"
          },
          "sizeLegendTitle": {
            "type": "string",
            "description": "Size legend title text; unset uses the size column name"
          },
          "sizeDomain": {
            "type": "array",
            "items": {},
            "description": "User-narrowed [lo, hi] window for the size scale"
          },
          "binCount": {
            "type": "number",
            "description": "Histogram: bin-count hint (Mosaic snaps to nice widths); unset bins automatically"
          },
          "xLabel": {
            "type": "string",
            "description": "X-axis title override"
          },
          "yLabel": {
            "type": "string",
            "description": "Y-axis title override"
          },
          "xGrid": {
            "type": "boolean",
            "description": "X-axis grid lines"
          },
          "yGrid": {
            "type": "boolean",
            "description": "Y-axis grid lines"
          }
        }
      },
      "preconditions": [
        "a Relation to display"
      ],
      "dynamicPorts": {
        "kind": "chart-channels",
        "field": "viewType",
        "default": "table",
        "port": {
          "idPrefix": "channel:",
          "type": "ColumnRef",
          "cardinality": "one"
        }
      }
    },
    {
      "type": "legend",
      "label": "Legend",
      "description": "Shows a color/size legend for a field and shares its scale with attached views.",
      "renderable": true,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "data",
          "type": "Relation",
          "role": "input",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "filter",
          "type": "ScalarParam",
          "role": "filter",
          "cardinality": "many",
          "required": false
        },
        {
          "id": "scale",
          "type": "Scale",
          "role": "scale",
          "cardinality": "many",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Tile title shown on the dashboard"
          },
          "field": {
            "type": "string",
            "description": "Column the legend maps"
          },
          "channel": {
            "type": "string",
            "enum": [
              "color",
              "r",
              "symbol"
            ],
            "default": "color",
            "description": "Encoding this legend represents"
          },
          "scheme": {
            "type": "string",
            "description": "Color scheme name (continuous / discrete)"
          },
          "range": {
            "type": "array",
            "items": {},
            "description": "Explicit colors/radii (overrides scheme)"
          },
          "selected": {
            "description": "Per-field kept-values map (or a legacy single array for the manual `field`)"
          },
          "colors": {
            "type": "object",
            "description": "Per-field category→color overrides from the legend swatch picker: { [field]: { [value]: \"#rrggbb\" } }"
          },
          "colorRangeMode": {
            "type": "string",
            "enum": [
              "recolor",
              "filter"
