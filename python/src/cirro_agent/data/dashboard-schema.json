      "configSchema": null,
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "chart-render",
      "label": "Chart Preview",
      "description": "Renders the Mosaic spec as a live chart over the query result (DuckDB-WASM).",
      "renderable": true,
      "addableViaMenu": false,
      "inputs": [
        {
          "id": "spec",
          "type": "ChartSpec",
          "role": "chart spec",
          "cardinality": "one",
          "required": true
        },
        {
          "id": "relation",
          "type": "Relation",
          "role": "input",
          "cardinality": "one",
          "required": true
        }
