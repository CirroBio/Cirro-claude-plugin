{
  "format": 1,
  "persistVersion": 1,
  "cellIdPattern": "^[a-z0-9]{4,32}$",
  "sqlTokenPattern": "\\{(\\w+)\\}",
  "mosaicSchemaUrl": "https://uwdata.github.io/mosaic/schema/latest.json",
  "grid": {
    "columns": 12,
    "tileWidth": 12,
    "tileHeight": 10,
    "soloTileHeight": 16
  },
  "portTypes": [
    "Relation",
    "ColumnRef",
    "ScalarParam",
    "Selection",
    "ChartType",
    "ChartSpec",
    "Scale"
  ],
  "dataTypeClasses": [
    "quantitative",
    "categorical",
    "temporal"
  ],
  "encodingChannels": [
    "x",
    "y",
    "color",
    "size",
    "detail"
  ],
  "nodeTypes": [
    {
      "type": "sql-query",
      "label": "SQL",
      "description": "Runs SQL over one or more wired sheets/dataset files (query, in1, in2…), producing a result.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "upstream",
          "type": "Relation",
          "role": "input",
          "cardinality": "many",
          "required": false
        }
      ],
      "outputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "output",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "The node's SQL text; {tokens} are substituted from wired params"
          },
          "defaultLimit": {
            "type": "boolean",
            "description": "Set when the starter query auto-applied the default LIMIT"
          }
        }
      },
      "preconditions": [],
      "dynamicPorts": {
        "kind": "sql-tokens",
        "field": "sql",
        "pattern": "\\{(\\w+)\\}",
        "port": {
          "idPrefix": "param:",
          "type": "ScalarParam",
          "cardinality": "one",
          "required": false
        }
      }
    },
    {
      "type": "dataset-source",
      "label": "Sheet",
      "description": "Selects a Cirro Sheet (table or view) as a data source.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [],
      "outputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "file rows",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "sheetId": {
            "type": "string",
            "description": "Cirro Sheet id of the dataset file"
          },
          "tableName": {
            "type": "string",
            "description": "SQL table name of the dataset file"
          },
          "sql": {
            "type": "string",
            "description": "Generated source query (SELECT * FROM <tableName>)"
          }
        }
      },
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "dataset-file",
      "label": "Dataset File",
      "description": "Points to a file (CSV/TSV/Parquet/JSON) in a Cirro dataset as a data source.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [],
      "outputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "file rows",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "description": "Cirro dataset id"
          },
          "datasetName": {
            "type": "string",
            "description": "Dataset display name"
          },
          "path": {
            "type": "string",
            "description": "Relative path of the file within the dataset"
          },
          "fileType": {
            "type": "string",
            "enum": [
              "csv",
              "tsv",
              "parquet",
              "json",
              "txt"
            ],
            "description": "File format"
          },
          "tableName": {
            "type": "string",
            "description": "SQL table/alias name (derived from the basename)"
          },
          "sizeBytes": {
            "type": "number",
            "description": "File size in bytes from the dataset manifest (drives the starter default LIMIT)"
          }
        }
      },
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "namespace-query",
      "label": "Query",
      "description": "Runs SQL on the server and loads only the result.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [],
      "outputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "query rows",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL executed by the backend against the project namespace"
          },
          "tableName": {
            "type": "string",
            "description": "Catalog table this query targets, used to resolve the node's form fields — not a downstream SQL alias (the downstream alias is deliberately `query`, see NamespaceQueryConfig.tableName)"
          }
        }
      },
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "discussion",
      "label": "Discussion",
      "description": "A discussion thread scoped to this dashboard.",
      "renderable": true,
      "addableViaMenu": false,
      "inputs": [],
      "outputs": [],
      "configSchema": {
        "type": "object",
        "properties": {}
      },
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "input",
      "label": "Input control",
      "description": "A user control (text, number, select, multi-select, or range) whose value can drive downstream SQL.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "data",
          "type": "Relation",
          "role": "options",
          "cardinality": "one",
          "required": false
        }
      ],
      "outputs": [
        {
          "id": "value",
          "type": "ScalarParam",
          "role": "value(s)",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Display label"
          },
          "inputType": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "select",
              "multiselect",
              "range"
            ],
            "default": "text",
            "description": "Control kind"
          },
          "value": {
            "type": "string",
            "description": "Current value"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Options for a select (user-provided list)"
          },
          "optionsColumn": {
            "type": "string",
            "description": "Column whose distinct values populate a bound select"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Selected values for a multiselect"
          },
          "column": {
            "type": "string",
            "description": "Column this control subsets (set when bound to a chart property)"
          },
          "lo": {
            "type": "number",
            "description": "Lower bound for a range control"
          },
          "hi": {
            "type": "number",
            "description": "Upper bound for a range control"
          }
        }
      },
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "join",
      "label": "Join",
      "description": "Combines two relations on a key column (inner/left/right/full).",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "lhs",
          "type": "Relation",
          "role": "left",
          "cardinality": "one",
          "required": true
        },
        {
          "id": "rhs",
          "type": "Relation",
          "role": "right",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "output",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "joinType": {
            "type": "string",
            "enum": [
              "inner",
              "left",
              "right",
              "full"
            ],
            "description": "SQL join type"
          },
          "leftKey": {
            "type": "string",
            "description": "Join key column from the left input"
          },
          "rightKey": {
            "type": "string",
            "description": "Join key column from the right input"
          },
          "sql": {
            "type": "string",
            "description": "Generated join query"
          }
        }
      },
      "preconditions": [
        "two Relation inputs"
      ],
      "dynamicPorts": null
    },
    {
      "type": "param",
      "label": "Parameter",
      "description": "A typed value (number/text) substituted into downstream SQL as {{name}}.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [],
      "outputs": [
        {
          "id": "value",
          "type": "ScalarParam",
          "role": "value",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Placeholder name; referenced as {{name}}"
          },
          "paramType": {
            "type": "string",
            "enum": [
              "number",
              "text"
            ],
            "description": "Value type"
          },
          "value": {
            "type": "string",
            "description": "Current value"
          }
        }
      },
      "preconditions": [],
      "dynamicPorts": null
    },
    {
      "type": "result-grid",
      "label": "Result Grid",
      "description": "Displays a Relation as a paginated data grid.",
      "renderable": true,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "input",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [],
      "configSchema": null,
      "preconditions": [
        "a Relation to display"
      ],
      "dynamicPorts": null
    },
    {
      "type": "viz-picker",
      "label": "Visualization",
      "description": "Pick a chart type filtered by the data types present in the Relation.",
      "renderable": false,
      "addableViaMenu": false,
      "inputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "input",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "chartType",
          "type": "ChartType",
          "role": "chart type",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": null,
      "preconditions": [
        "a Relation with at least one chartable column"
      ],
      "dynamicPorts": null
    },
    {
      "type": "column",
      "label": "Column",
      "description": "Selects one column of a wired table as a reusable column reference.",
      "renderable": false,
      "addableViaMenu": true,
      "inputs": [
        {
          "id": "relation",
          "type": "Relation",
          "role": "input",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "column",
          "type": "ColumnRef",
          "role": "column",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "column": {
            "type": "string",
            "description": "Selected column name"
          },
          "columnClass": {
            "type": "string",
            "enum": [
              "quantitative",
              "categorical",
              "temporal"
            ],
            "description": "Data class of the selected column"
          }
        }
      },
      "preconditions": [
        "a wired table"
      ],
      "dynamicPorts": {
        "kind": "column-class",
        "field": "columnClass",
        "outputPort": "column"
      }
    },
    {
      "type": "channel-binding",
      "label": "Channel Bindings",
      "description": "Bind result columns to a chart's encoding channels (x, y, color, size).",
      "renderable": false,
      "addableViaMenu": false,
      "inputs": [
        {
          "id": "chartType",
          "type": "ChartType",
          "role": "chart type",
          "cardinality": "one",
          "required": true
        },
        {
          "id": "relation",
          "type": "Relation",
          "role": "columns",
          "cardinality": "one",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "chartSpec",
          "type": "ChartSpec",
          "role": "chart spec",
          "cardinality": "one",
          "required": false
        }
      ],
      "configSchema": null,
      "preconditions": [
        "a selected chart type",
        "a Relation with columns"
      ],
      "dynamicPorts": null
    },
    {
      "type": "chart-spec",
      "label": "Chart Spec",
      "description": "Edit the Mosaic JSON spec directly, with column-aware autocomplete and validation.",
      "renderable": false,
      "addableViaMenu": false,
      "inputs": [
        {
          "id": "spec",
          "type": "ChartSpec",
          "role": "chart spec",
          "cardinality": "one",
          "required": true
        },
        {
          "id": "relation",
          "type": "Relation",
          "role": "columns",
          "cardinality": "one",
          "required": false
        }
      ],
      "outputs": [
        {
          "id": "spec",
          "type": "ChartSpec",
          "role": "output",
          "cardinality": "one",
          "required": false
        }
