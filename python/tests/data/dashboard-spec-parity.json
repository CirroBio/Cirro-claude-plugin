  "scatter": {
    "bindings": {
      "x": "x_col",
      "y": "y_col",
      "color": "color_col",
      "size": "size_col"
    },
    "spec": {
      "$schema": "https://uwdata.github.io/mosaic/schema/latest.json",
      "plot": [
        {
          "mark": "dot",
          "data": {
            "from": "query"
          },
          "x": "x_col",
          "y": "y_col",
          "fill": "color_col",
          "fillOpacity": 0.7,
          "r": "size_col"
        }
      ],
      "xLabel": "X Col",
      "yLabel": "Y Col"
    },
    "readBack": {
      "x": "x_col",
      "y": "y_col",
      "color": "color_col",
      "size": "size_col"
    }
  },
  "boxplot": {
    "bindings": {
      "x": "x_col",
      "y": "y_col",
      "color": "color_col"
    },
    "spec": {
      "$schema": "https://uwdata.github.io/mosaic/schema/latest.json",
      "plot": [
        {
          "mark": "ruleX",
          "data": {
            "from": "query"
          },
          "x": "x_col",
          "y1": {
            "min": "y_col"
          },
          "y2": {
            "max": "y_col"
          },
          "stroke": "currentColor",
          "strokeOpacity": 0.7
        },
        {
          "mark": "barY",
          "data": {
            "from": "query"
          },
          "x": "x_col",
          "y1": {
            "quantile": [
              "y_col",
              0.25
            ]
          },
          "y2": {
            "quantile": [
              "y_col",
              0.75
            ]
          },
          "fill": "color_col",
          "fillOpacity": 0.85,
          "stroke": "currentColor"
        },
        {
          "mark": "tickY",
          "data": {
            "from": "query"
          },
          "x": "x_col",
          "y": {
            "median": "y_col"
          },
          "stroke": "currentColor",
          "strokeWidth": 2
        }
      ],
      "xLabel": "X Col"
    },
    "readBack": {
      "x": "x_col",
      "y": "y_col",
      "color": "color_col"
    }
  },
