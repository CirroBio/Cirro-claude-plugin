{
  "histogram": {
    "bindings": {
      "x": "x_col",
      "color": "color_col"
    },
    "spec": {
      "$schema": "https://uwdata.github.io/mosaic/schema/latest.json",
      "plot": [
        {
          "mark": "rectY",
          "data": {
            "from": "query"
          },
          "x": {
            "bin": "x_col"
          },
          "y": {
            "count": []
          },
          "fill": "color_col"
        }
      ],
      "xLabel": "X Col"
    },
    "readBack": {
      "x": "x_col",
      "color": "color_col"
    }
  },
  "bar": {
    "bindings": {
