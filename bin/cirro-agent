#!/usr/bin/env bash
# Read-only Cirro access. This entry point reaches no mutating code path, which is
# what makes a broad `Bash(cirro-agent *)` permission safe to grant.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${CIRRO_AGENT_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-$(cd "$HERE/.." && pwd)}}"
# shellcheck source=/dev/null
source "$ROOT/scripts/_resolve-python.sh"
CIRRO_AGENT_PLUGIN_ROOT="$ROOT"; export CIRRO_AGENT_PLUGIN_ROOT
if ! PY="$(resolve_python)"; then runtime_missing_json; exit 1; fi
export PYTHONPATH="$ROOT/python/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m cirro_agent.cli "$@"
